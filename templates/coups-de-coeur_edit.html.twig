{% extends 'base.html.twig' %}

{% block title %}
    {{ is_edit ? 'Edite le coup de cœur - ' ~ slug : 'Nouveau coup de cœur' }}
{% endblock %}

{% block content %}
<section>
    <h1>{{ is_edit ? 'Edite le coup de cœur' : 'Nouveau coup de cœur' }}</h1>

    {% if ean %}
    <img src="{{ image_ean_couv_small|eanUrl(ean) }}"
        data-src-small="{{ image_ean_couv_small|eanUrl(ean) }}"
        data-src-big="{{ image_ean_couv_big|eanUrl(ean) }}"
    >
    <img src="{{ image_ean_4couv_small|eanUrl(ean) }}"
        data-src-small="{{ image_ean_4couv_small|eanUrl(ean) }}"
        data-src-big="{{ image_ean_4couv_big|eanUrl(ean) }}"
    >
    {% endif %}
    
    {% if is_edit and category is not null and slug is not null %}
    <a href="{{path('coups-de-coeur_view', { category, slug })}}">Voir le post</a>
    {% endif %}

    {% for msg in app.flashes('success') %}
        <div style="color: green;">{{ msg }}</div>
    {% endfor %}
{# 
    {% if errors|length > 0 %}
        <ul style="color: red;">
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    {% endif %}
 #}
    {% if form %}
    {{ form(form) }}
    {% endif %}

    <hr/>
    <div id="divPreview"></div>
</section>
{% endblock %}

{% block endscripts %}
<script type="module">import "post";</script>
{% endblock %}
