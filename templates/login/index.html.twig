{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block content %}
    {% if error %}
        <div id="login_error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form action="{{ path('app_login') }}" method="post" name="login">
        <label for="username">Nom:</label>
        <input type="text" id="username" name="_username" value="{{ last_username }}" required autofocus>

        <label for="password">Mot de passe:</label>
        <input type="password" id="password" name="_password" required>

        {# <input type="hidden" name="_target_path" value="{{ path('admin') }}"> #}

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Connection</button>
    </form>
{% endblock %}