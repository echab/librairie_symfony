{% extends 'base.html.twig' %}

{% block title %}{{ post.titre }}{% endblock %}

{% block content %}
    <article class="post">
        <h1>{{ post.titre }}</h1>
        {% if post.auteur is not empty %}<h3>par {{ post.auteur }}</h3>{% endif %}

        <div class="contenu">{{ post.html|raw }}</div>

        <p class="info">
            {% if post.editeur is not empty %}<span>Edité par {{post.editeur}}</span>{% endif %}
            {% if post.prix is not empty %}<span>Prix&nbsp;: {{post.prix|euro}}</span>{% endif %}
            {% if post.parution is not empty %}<span>Paru le {{post.parution|format_date('long')}}</span>{% endif %}
            {# <span>{{post.n}}&nbsp;en stock</span> #}
            {% if post.ean is not empty %}
                <button class="addPanier"
                    data-ean="{{post.ean}}"
                    data-titre="{{post.titre}}"
                    data-auteur="{{post.auteur ?? ''}}"
                    data-prix="{{post.prix ?? 0}}"
                    data-rayon="{{post.rayonCode ?? ''}}"
                >Ajouter au panier</button>
            {% endif %}
            <a href="{{path('coups-de-coeur_rayon', { category: post.category })}}">Rayon {{post.category}}</a>
            <span>❤️ {{post.libraire ?? ''}} le {{ post.date|format_date('long') }}</span>
            {# <a class="post-edit-link" href="{{ path('post_edit', {'slug': post.slug}) }}">Modifier</a> #}
            <a href="{{ path('coups-de-coeur_edit', {'slug': post.slug, 'category': post.category }) }}">✎Modifier</a>
        </p>
    </article>
{% endblock %}