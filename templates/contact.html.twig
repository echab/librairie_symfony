{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block content %}
<section>
  <h1>Envoyez nous un message</h1>

  {% for label, messages in app.flashes %}
      {% for message in messages %}
          <div class="flash-{{ label }}">{{ message }}</div>
      {% endfor %}
  {% endfor %}

  {% if form %}
    {{ form(form) }}
  {% endif %}

  <h1>Venir à la librairie</h1>
  <iframe
      style="border: 0;"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1443.308900173146!2d1.4771288582032394!3d43.656119594780314!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12aea31cb9f5155d%3A0x529a0574981d6fdf!2s43+Avenue+de+Toulouse%2C+31240+L'Union!5e0!3m2!1sfr!2sfr!4v1449907946567"
      width="600" height="450"
      frameborder="0"
      allowfullscreen="allowfullscreen"
  ></iframe>
</section>
{% endblock %}