{% extends "base.html.twig" %}

{% block title %}Erreur {{ exception.statusCode }}{% endblock %}

{% block content %}
	<h1>Erreur {{ exception.statusCode }}</h1>

	{% if is_granted('IS_AUTHENTICATED') %}
        <p>exception.message: {{ exception.message }}</p>
		<pre>{{ exception.traceAsString }}</pre>
	{% endif %}
{% endblock %}
