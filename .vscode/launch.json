{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "hostname": "localhost",
            "port": [ 
                9000,
                9003
            ],
            "pathMappings": {
                "/app": "${workspaceFolder}"
            }
        },
        {
            "name": "Launch currently open script",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "port": 9004,
            "runtimeArgs": [
                "-dxdebug.start_with_request=yes"
            ],
            "env": {
                "XDEBUG_MODE": "debug,develop",
                "XDEBUG_CONFIG": "client_port=9004"
            }
        },
        {
            "name": "Launch symfony Command",
            "type": "php",
            "request": "launch",
            "program": "${workspaceRoot}/bin/console",
            "cwd": "${workspaceRoot}",
            "port": 9004,
            "runtimeArgs": [
                "-dxdebug.start_with_request=yes",
                // "-x",
            ],
            "args": [
                "app:import-wordpress-xml",
                // "../data/librairie-lespassantes.WordPress.2025-07-31_coups-de-coeur_Tania.xml"
                "../data/librairie-lespassantes.WordPress.2025-07-31_coups-de-coeur.xml"
                // "../data/Philippe-Bouquet-2021php@gmail.com-WordPress.2025-08-19.xml"
            ],
            "env": {
                "XDEBUG_MODE": "debug,develop",
                "XDEBUG_CONFIG": "client_port=9004",
                "XDEBUG_SESSION": "1",
                "XDEBUG_ACTIVATED": "1",
            }
        },
        {
            "name": "Launch Built-in web server",
            "type": "php",
            "request": "launch",
            "runtimeArgs": [
                "-dxdebug.mode=debug",
                "-dxdebug.start_with_request=yes",
                "-S",
                "localhost:0"
            ],
            "program": "",
            "cwd": "${workspaceRoot}",
            "port": 9003,
            "serverReadyAction": {
                "pattern": "Development Server \\(http://localhost:([0-9]+)\\) started",
                "uriFormat": "http://localhost:%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Debug en lançant le serveur intégré",
            "type": "php",
            "request": "launch",
            "noDebug": false,
            "runtimeArgs": [
                "-S",
                "localhost:8001",
                "-t",
                "."
            ],
            "cwd": "${workspaceRoot}/public",
            "serverReadyAction": {
                "action": "openExternally"
            },
            "envFile": ".env"
        },
        {
            "name": "Launch built-in server and Profile",
            "type": "php",
            "request": "launch",
            "noDebug": true,
            "runtimeArgs": [
                "-S",
                "localhost:8001",
                "-t",
                "."
            ],
            "cwd": "${workspaceRoot}/public",
            "serverReadyAction": {
                "action": "openExternally"
            },
            "envFile": "../.env",
            "profile": true,
            "openProfile": true
        }
    ]
}